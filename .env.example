# Copy to .env and edit. NEVER commit .env. Every value below is a placeholder.
# The app refuses to start while any secret is still a placeholder.

APP_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret_of_at_least_32_chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_unique_password
# Changing ADMIN_PASSWORD and recreating the containers rotates the login AND signs out existing sessions.

# --- MongoDB (created by the project's own container) ---
MONGO_ROOT_USERNAME=webpilot_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_DATABASE=webpilot
# Optional full URI; overrides the three values above for the app (host defaults to the webpilot-mongo container).
# MONGO_URI=

# --- Existing Redis (NOT created by this project) ---
# Hostname/alias of your Redis container as seen from the REDIS_NETWORK below (see `docker ps`).
REDIS_HOST=redis
REDIS_PORT=6379
# Confirm this logical DB is unused by your other apps before deploying.
REDIS_DB=4
REDIS_PASSWORD=
CELERY_QUEUE=webpilot

# --- Existing Docker network your Redis container is on (see `docker network ls`) ---
REDIS_NETWORK=redis_default

# --- Groq ---
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Client-side pacing per worker process. Divide your Groq quota by MAX_CONCURRENT_BROWSER_TASKS.
GROQ_REQUESTS_PER_MINUTE=20
# json_object (default) | json_schema | none. Fall back to "none" if your model rejects JSON mode.
GROQ_RESPONSE_FORMAT=json_object
# Optional for gpt-oss models: low | medium | high. Leave empty for other models.
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2048

# --- Agent limits (initial defaults; tune after watching `docker stats`) ---
MAX_ACTIONS_PER_TASK=100
MAX_TASK_DURATION_SECONDS=900
MAX_RECOVERY_ATTEMPTS=3
MAX_LLM_RETRIES=3
MAX_CONCURRENT_BROWSER_TASKS=1
BROWSER_NAVIGATION_TIMEOUT_MS=30000
# Keep true. See README "Browser sandbox" before ever turning this off.
BROWSER_SANDBOX=true

# --- Misc ---
APP_PORT=8000
ARTIFACT_DIR=/app/artifacts
ARTIFACT_RETENTION_DAYS=14
LOG_LEVEL=INFO
# The dashboard is published on port 8051 (http://<server-ip>:8051).
# 0.0.0.0 = reachable from the network; 127.0.0.1 = only from the server itself (use an SSH tunnel).
BIND_ADDRESS=0.0.0.0
# false is REQUIRED while you access the dashboard over plain http://IP:8051, otherwise the browser drops the
# session cookie and login appears to do nothing. Set to true once you put HTTPS in front.
SECURE_COOKIES=false
# Reverse proxies in front of the app. 0 = none (direct IP:port access). Never raise this without a proxy:
# clients could then spoof X-Forwarded-For to dodge the login rate limit.
TRUSTED_PROXIES=0
# Resource caps for the worker container
WORKER_MEM_LIMIT=3g
WORKER_CPUS=2
